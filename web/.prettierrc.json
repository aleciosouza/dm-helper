{
    "$schema": "https://json.schemastore.org/prettierrc",
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 120,
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
        "<BUILT_IN_MODULES>",
        "",
        "^(react|react-dom|react-router)(/.*)?$",
        "^@react-router/(.*)$",
        "<THIRD_PARTY_MODULES>",
        "",
        "^~/(.*)$",
        "^[./].*(?<!\\.(css|scss))$",
        "",
        "^.*\\.(css|scss)$"
    ],
    "importOrderTypeScriptVersion": "5.9.3"
}
